# Makefile for Macintosh Quadra 800 ROM Decompilation & Reconstructed Sources

HOST_CC ?= gcc
HOST_CFLAGS ?= -Wall -Wextra -O2 -Iinclude -Iboot -Itraps -Itoolbox -Ideclrom -std=c11

SRCS = main.c \
       traps/trap_table.c \
       traps/trap_unpacker.c \
       boot/cpu68040.c \
       boot/hwinit.c \
       boot/lowmem_init.c \
       toolbox/mem_manager.c \
       toolbox/resource_mgr.c \
       toolbox/quickdraw.c \
       toolbox/slot_mgr.c \
       toolbox/os_traps.c \
       declrom/declrom_quadra.c \
       declrom/video_dafb.c

HOST_OBJS = $(SRCS:.c=.o)
TARGET = quadra_rom_harness

# Motorola 68040 Cross-Toolchain
M68K_CC ?= /usr/bin/m68k-suse-linux-gcc
M68K_AS ?= /usr/m68k-suse-linux/bin/as
M68K_LD ?= /usr/m68k-suse-linux/bin/ld
M68K_OBJCOPY ?= /usr/bin/m68k-suse-linux-objcopy

M68K_CFLAGS = -m68040 -nostdlib -ffreestanding -Iinclude -Iboot -Itraps -Itoolbox -Ideclrom -O2
M68K_ASFLAGS = -m68030

BUILD_DIR = ../build
REBUILT_ROM = $(BUILD_DIR)/QUADRA800_REBUILT.ROM
STANDALONE_ROM = $(BUILD_DIR)/QUADRA800_STANDALONE.ROM
ELF_TARGET = $(BUILD_DIR)/q800_rom.elf

# Base ROM image, assembled from the disassembled ROM source in romsrc/
# (labelled 68040 assembly generated by tools/rom_disasm.py; see romsrc-regen).
ROMSRC_SRCS = $(wildcard romsrc/*.s romsrc/include/*.inc)
ROMSRC_OBJ = $(BUILD_DIR)/q800rom.o
ROMSRC_ELF = $(BUILD_DIR)/q800rom_base.elf
BASE_ROM = $(BUILD_DIR)/QUADRA800_BASE.ROM

M68K_C_SRCS = boot/cpu68040.c \
              boot/hwinit.c \
              boot/lowmem_init.c \
              toolbox/mem_manager.c \
              toolbox/resource_mgr.c \
              toolbox/quickdraw.c \
              toolbox/slot_mgr.c \
              toolbox/os_traps.c \
              declrom/declrom_quadra.c \
              declrom/video_dafb.c \
              traps/trap_unpacker.c \
              traps/trap_table.c

M68K_C_OBJS = $(patsubst %.c,$(BUILD_DIR)/%_m68k.o,$(M68K_C_SRCS))

.PHONY: all clean run m68k rom test-qemu test-boot test-shift romsrc-regen romsrc-reanalyze

all: $(TARGET) rom

# Host Verification Harness
$(TARGET): $(HOST_OBJS)
	$(HOST_CC) $(HOST_CFLAGS) -o $@ $(HOST_OBJS)

%.o: %.c
	$(HOST_CC) $(HOST_CFLAGS) -c $< -o $@

run: $(TARGET) rom
	./$(TARGET) $(REBUILT_ROM)

# Bare-metal M68K compilation
boot/reset.o: boot/reset.s
	$(M68K_AS) $(M68K_ASFLAGS) $< -o $@

traps/trap_dispatcher.o: traps/trap_dispatcher.s
	$(M68K_AS) $(M68K_ASFLAGS) $< -o $@

$(BUILD_DIR)/%_m68k.o: %.c
	@mkdir -p $(dir $@)
	$(M68K_CC) $(M68K_CFLAGS) -c $< -o $@

m68k: boot/reset.o traps/trap_dispatcher.o $(M68K_C_OBJS)
	@echo "All bare-metal 68040 C and assembly objects built successfully."

$(ELF_TARGET): boot/reset.o traps/trap_dispatcher.o $(M68K_C_OBJS) rom.ld
	@mkdir -p $(BUILD_DIR)
	$(M68K_LD) -T rom.ld boot/reset.o traps/trap_dispatcher.o $(M68K_C_OBJS) -o $@

# Assemble the base ROM image from source and check it against the recorded hash
$(ROMSRC_OBJ): $(ROMSRC_SRCS)
	@mkdir -p $(BUILD_DIR)
	$(M68K_AS) -m68040 -I romsrc -I romsrc/include romsrc/q800rom.s -o $@

# Linked at ROMBase so that label references resolve to ROM addresses
$(ROMSRC_ELF): $(ROMSRC_OBJ)
	$(M68K_LD) -Ttext=0x40800000 -e 0x40800000 --no-warn-rwx-segments -o $@ $<

# Post-link: the packed trap table is re-encoded from the linked label addresses and the
# checksums are recomputed (both needed once code moves). When the source is unmodified the
# image is identical to the original ROM; a mismatch is reported but is not an error.
$(BASE_ROM): $(ROMSRC_ELF) romsrc/q800rom.sha256 romsrc/traptable.lst
	$(M68K_OBJCOPY) -O binary --only-section=.text $< $@
	@python3 tools/rom_postlink.py $< $@ romsrc > /dev/null
	@cd $(BUILD_DIR) && (sha256sum --quiet -c $(CURDIR)/romsrc/q800rom.sha256 2>/dev/null \
		&& echo "Base ROM image $@ is identical to the original ROM") \
		|| echo "Base ROM image $@ differs from the original ROM (modified source)"

# Regenerate romsrc/ from an original ROM, using the committed analysis in ../analysis
# (deterministic: produces the tested source; does not need Ghidra).
ORIG_ROM ?= ../QUADRA800.ROM
romsrc-regen:
	tools/regen_romsrc.sh $(ORIG_ROM)

# Full re-analysis with Ghidra (analyzeHeadless) to improve coverage. This changes the
# generated source: run "make test-shift" (several SHIFT_AT values) before committing.
romsrc-reanalyze:
	tools/regen_romsrc.sh --reanalyze $(ORIG_ROM)

# Build complete 1MB ROM images and compute checksums
rom: $(ELF_TARGET) $(BASE_ROM)
	@mkdir -p $(BUILD_DIR)
	python3 tools/build_rom.py standalone $(STANDALONE_ROM) $(ELF_TARGET)
	python3 tools/build_rom.py overlay $(REBUILT_ROM) $(BASE_ROM) . $(ROMSRC_ELF)
	@python3 tools/rom_checksum.py $(REBUILT_ROM) --verify

# Headless QEMU smoke test: the ROM must reach the desktop (grey screen + cursor)
test-boot: rom
	python3 tools/qemu_boot_test.py $(REBUILT_ROM) 15

# Relocatability check: insert bytes before a function (filled with ILLEGAL), so that
# almost the whole ROM moves, rebuild, and boot it headless. Override with
# SHIFT_AT=<ROM address> SHIFT_BYTES=<n>.
SHIFT_AT ?= 0x40801000
SHIFT_BYTES ?= 0x40
test-shift: romsrc/q800rom.s
	python3 tools/shift_test.py --at $(SHIFT_AT) --bytes $(SHIFT_BYTES)

# Launch QEMU virtual machine to boot the built ROM
test-qemu: rom
	@echo "Booting $(REBUILT_ROM) in QEMU Macintosh Quadra 800 machine..."
	qemu-system-m68k -M q800 -bios $(REBUILT_ROM) -m 64M

clean:
	rm -f $(HOST_OBJS) $(TARGET) boot/*.o traps/*.o toolbox/*.o declrom/*.o
	rm -rf $(BUILD_DIR)
