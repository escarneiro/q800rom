# Makefile for the Macintosh Quadra 800 ROM, built from the disassembled source in romsrc/

# Motorola 68040 Cross-Toolchain (GNU binutils). Override on the command line for another
# toolchain, e.g. make M68K_AS=m68k-linux-gnu-as ...; the values are exported to the tools.
M68K_AS ?= /usr/m68k-suse-linux/bin/as
M68K_LD ?= /usr/m68k-suse-linux/bin/ld
M68K_NM ?= /usr/m68k-suse-linux/bin/nm
M68K_OBJCOPY ?= /usr/bin/m68k-suse-linux-objcopy
M68K_OBJDUMP ?= /usr/bin/m68k-suse-linux-objdump
export M68K_AS M68K_LD M68K_NM M68K_OBJCOPY M68K_OBJDUMP

BUILD_DIR = ../build

# The ROM image is assembled from the disassembled ROM source in romsrc/
# (labelled 68040 assembly generated by tools/rom_disasm.py; see romsrc-regen).
REBUILT_ROM = $(BUILD_DIR)/QUADRA800_REBUILT.ROM
ROMSRC_SRCS = $(shell find romsrc -name '*.s' -o -name '*.inc' -o -name '*.bin' 2>/dev/null)
ROMSRC_OBJ = $(BUILD_DIR)/q800rom.o
ROMSRC_ELF = $(BUILD_DIR)/q800rom.elf

# Replacement media: files generated into $(MEDIA_DIR)/<option>/ take the place of the
# romsrc/ file with the same path (the assembler searches those directories first).
#   make CHIME=my.wav   boot chime from a WAV file (tools/wav2snd.py). The sound is padded
#                       to CHIME_AREA bytes, the size of the original sound area
#                       (romsrc/sound/bootchime.s), so nothing else in the ROM moves; a
#                       longer sound is cut (about 3.1 s fit).
#   make ALERT=my.wav   alert sound ('snd ' 1, used when the System file has none) from a
#                       WAV file; ALERT_AREA bytes (0.12 s), cut if longer
#   make BEEPS=file     boot beep and error beeps from a text file (tools/beeps2s.py)
#   make ICONS=dir      icons and cursors from PNGs in dir/boot, sony, edisk, atboot and
#                       cursors (tools/icons2s.py lists the names); a missing PNG keeps
#                       the original. Same sizes, so nothing else moves.
#   make FONTS=dir      bitmap fonts from dir/chicago12.bdf, geneva9.bdf, geneva12.bdf,
#                       monaco9.bdf (tools/fonts2s.py); a missing file keeps the original.
#                       Each font keeps its size, so nothing else moves.
#   make FILLER=1       the filler in unused places (Apple's team initials, copyright and
#                       build date, repeated) becomes Lorem Ipsum, ending with the
#                       project's address (tools/fill2s.py)
#   make FREE_MEDIA=1   the project's own sounds, icons, cursors and fonts (../media, no
#                       Apple material), and FILLER=1
ifneq ($(FREE_MEDIA),)
CHIME ?= ../media/chime.wav
ALERT ?= ../media/alert.wav
BEEPS ?= ../media/beeps.txt
ICONS ?= ../media/icons
FONTS ?= ../media/fonts
FILLER ?= 1
endif
MEDIA_DIR = $(BUILD_DIR)/media
MEDIA_CFG = $(BUILD_DIR)/media.cfg
MEDIA_FILES =
MEDIA_INC =
CHIME_AREA ?= 0x10D8C
ifneq ($(CHIME),)
MEDIA_FILES += $(MEDIA_DIR)/chime/sound/bootchime.s
MEDIA_INC += -I $(MEDIA_DIR)/chime
endif
ALERT_AREA ?= 2762
ifneq ($(ALERT),)
MEDIA_FILES += $(MEDIA_DIR)/alert/sound/alertsound.s
MEDIA_INC += -I $(MEDIA_DIR)/alert
endif
ifneq ($(BEEPS),)
MEDIA_FILES += $(MEDIA_DIR)/beeps/sound/beeptable.s
MEDIA_INC += -I $(MEDIA_DIR)/beeps
endif
ifneq ($(ICONS),)
MEDIA_FILES += $(MEDIA_DIR)/icons.stamp
MEDIA_INC += -I $(MEDIA_DIR)/icons
endif
ifneq ($(FONTS),)
MEDIA_FILES += $(MEDIA_DIR)/fonts.stamp
MEDIA_INC += -I $(MEDIA_DIR)/fonts
endif
ifneq ($(FILLER),)
MEDIA_FILES += $(MEDIA_DIR)/filler/romfill.inc
MEDIA_INC += -I $(MEDIA_DIR)/filler
endif
MEDIA_SETTINGS = CHIME=$(CHIME) CHIME_AREA=$(CHIME_AREA) ALERT=$(ALERT) ALERT_AREA=$(ALERT_AREA) \
	BEEPS=$(BEEPS) ICONS=$(ICONS) FONTS=$(FONTS) FILLER=$(FILLER)

.PHONY: all clean rom applemedia FORCE test-qemu test-boot test-shift romsrc-regen romsrc-reanalyze

all: rom

# romsrc/ is generated (not in git): explain how to create it instead of failing in the assembler
romsrc/q800rom.s:
	@echo "src/romsrc/ does not exist yet. Generate it from your own ROM image first:" >&2
	@echo "    make -C src romsrc-regen ORIG_ROM=/path/to/QUADRA800.ROM" >&2
	@exit 1

# Records the media options, so that changing them rebuilds the ROM
$(MEDIA_CFG): FORCE
	@mkdir -p $(BUILD_DIR)
	@echo '$(MEDIA_SETTINGS)' | cmp -s - $@ || echo '$(MEDIA_SETTINGS)' > $@
FORCE:

$(MEDIA_DIR)/chime/sound/bootchime.s: $(CHIME) tools/wav2snd.py $(MEDIA_CFG)
	@mkdir -p $(dir $@)
	python3 tools/wav2snd.py $(CHIME) $@ --asm $(CHIME_AREA)

$(MEDIA_DIR)/alert/sound/alertsound.s: $(ALERT) tools/wav2snd.py $(MEDIA_CFG)
	@mkdir -p $(dir $@)
	python3 tools/wav2snd.py $(ALERT) $@ --asm $(ALERT_AREA) --label ALERTSOUND

$(MEDIA_DIR)/beeps/sound/beeptable.s: $(BEEPS) tools/beeps2s.py $(MEDIA_CFG)
	@mkdir -p $(dir $@)
	python3 tools/beeps2s.py $(BEEPS) -o $@

$(MEDIA_DIR)/icons.stamp: $(shell find $(ICONS) -name '*.png' 2>/dev/null) tools/icons2s.py $(MEDIA_CFG)
	rm -rf $(MEDIA_DIR)/icons
	python3 tools/icons2s.py $(ICONS) --romsrc romsrc -o $(MEDIA_DIR)/icons
	@touch $@

$(MEDIA_DIR)/fonts.stamp: $(wildcard $(FONTS)/*.bdf) tools/fonts2s.py $(MEDIA_CFG)
	rm -rf $(MEDIA_DIR)/fonts
	python3 tools/fonts2s.py $(FONTS) -o $(MEDIA_DIR)/fonts
	@touch $@

$(MEDIA_DIR)/filler/romfill.inc: romsrc/include/romfill.inc tools/fill2s.py $(MEDIA_CFG)
	@mkdir -p $(dir $@)
	python3 tools/fill2s.py --romsrc romsrc/include/romfill.inc -o $@

# Assemble the ROM source
$(ROMSRC_OBJ): romsrc/q800rom.s $(ROMSRC_SRCS) $(MEDIA_CFG) $(MEDIA_FILES)
	@mkdir -p $(BUILD_DIR)
	$(M68K_AS) -m68040 $(MEDIA_INC) -I romsrc -I romsrc/include romsrc/q800rom.s -o $@
	@if [ -n "$$($(M68K_NM) -u $@)" ]; then echo "undefined symbols:" >&2; \
		$(M68K_NM) -u $@ >&2; rm -f $@; exit 1; fi

# Linked at ROMBase so that label references resolve to ROM addresses
$(ROMSRC_ELF): $(ROMSRC_OBJ)
	$(M68K_LD) -Ttext=0x40800000 -e 0x40800000 --no-warn-rwx-segments -o $@ $<

# Post-link: the packed trap table is re-encoded from the linked label addresses and the
# checksums are recomputed (both needed once code moves). If a trap table entry has to grow
# (its routine moved too far for its encoding), rom_postlink.py rewrites the entry in the
# source and exits with 3: the ROM is then assembled and linked again. When the source is unmodified the
# image is identical to the original ROM; a mismatch is reported but is not an error.
$(REBUILT_ROM): $(ROMSRC_ELF) romsrc/q800rom.sha256 romsrc/traptable.lst romsrc/relocs.lst
	$(M68K_OBJCOPY) -O binary --only-section=.text $< $@
	@python3 tools/rom_postlink.py $< $@ romsrc > $(BUILD_DIR)/postlink.log; rc=$$?; \
	if [ $$rc = 3 ]; then rm -f $@; cat $(BUILD_DIR)/postlink.log; exec $(MAKE) --no-print-directory rom; fi; \
	if [ $$rc != 0 ]; then cat $(BUILD_DIR)/postlink.log >&2; rm -f $@; exit $$rc; fi
	@if [ "$$(sha256sum $@ | cut -d' ' -f1)" = "$$(cut -d' ' -f1 romsrc/q800rom.sha256)" ]; \
		then echo "ROM image $@ is identical to the original ROM"; \
		else echo "ROM image $@ differs from the original ROM (modified source)"; \
		if [ -f "$(ORIG_ROM)" ]; then python3 tools/macos_compat.py $< $@ "$(ORIG_ROM)" || true; fi; fi

# Regenerate romsrc/ from an original ROM, using the committed analysis in ../analysis
# (deterministic: produces the tested source; does not need Ghidra).
ORIG_ROM ?= ../QUADRA800.ROM
romsrc-regen:
	tools/regen_romsrc.sh $(ORIG_ROM)

# Full re-analysis with Ghidra (analyzeHeadless) to improve coverage. This changes the
# generated source: run "make test-shift" (several SHIFT_AT values) before committing.
romsrc-reanalyze:
	tools/regen_romsrc.sh --reanalyze $(ORIG_ROM)

# Apple's media and resources from an original ROM, in readable formats, into ../applemedia
# (for reference; not in git)
applemedia:
	python3 tools/extract_applemedia.py $(ORIG_ROM) ../applemedia

# Build the 1MB ROM image and check its checksum
rom: $(REBUILT_ROM)
	@python3 tools/rom_checksum.py $(REBUILT_ROM) --verify

# Headless QEMU smoke test: the ROM must reach the desktop (grey screen + cursor)
test-boot: rom
	python3 tools/qemu_boot_test.py $(REBUILT_ROM) 15

# Relocatability check: insert bytes before a function (filled with ILLEGAL), so that
# almost the whole ROM moves, rebuild, and boot it headless. Override with
# SHIFT_AT=<ROM address> SHIFT_BYTES=<n>.
SHIFT_AT ?= 0x40801000
SHIFT_BYTES ?= 0x40
test-shift: romsrc/q800rom.s
	python3 tools/shift_test.py --at $(SHIFT_AT) --bytes $(SHIFT_BYTES)

# Launch QEMU virtual machine to boot the built ROM
test-qemu: rom
	@echo "Booting $(REBUILT_ROM) in QEMU Macintosh Quadra 800 machine..."
	qemu-system-m68k -M q800 -bios $(REBUILT_ROM) -m 64M

clean:
	rm -rf $(BUILD_DIR)
